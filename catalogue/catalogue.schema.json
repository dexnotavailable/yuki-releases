{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dexnotavailable/yuki-releases/main/catalogue/catalogue.schema.json",
  "title": "YUKI model and skill catalogue",
  "description": "Pointers to models (on Hugging Face) and skills YUKI can download. No weights live in this repo. schemaVersion 1; a breaking change gets a new file (catalogue.v2.json) so installed apps keep reading this one. Apps ignore fields they do not know, so adding an optional field is not breaking.",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "models", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } }
  },
  "$defs": {
    "id": {
      "description": "Lowercase letters, digits, dots and dashes, up to 64, not ending in a dot. Unique across models and skills. Skill ids become folder names, so a name Windows keeps for devices (con, prn, aux, nul, com0-com9, lpt0-lpt9, with or without an extension) is refused.",
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:\\.|$))[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9-])?$"
    },
    "tier": {
      "description": "Hardware tier, from the best NVIDIA card and the RAM: S (24 GB card and 64 GB RAM) > A (20 GB card and 32 GB RAM) > B (12 GB card) > C (8 GB card) > D (no usable NVIDIA card). A card that misses its tier's RAM falls to the next tier it meets (a 24 GB card with 32 GB RAM is A, with 16 GB RAM B).",
      "enum": ["S", "A", "B", "C", "D"]
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "description": "Forward slashes, no leading slash, no empty, '.' or '..' parts, no drive letters. Every part must be a name Windows can make: none of \\ : * ? \" < > | or control characters, not ending in a dot or a space, and not a device name (con, prn, aux, nul, conin$, conout$, com0-com9, lpt0-lpt9, with or without an extension).",
      "type": "string",
      "maxLength": 400,
      "pattern": "^(?!(?:[Cc][Oo][Nn](?:[Ii][Nn]\\$|[Oo][Uu][Tt]\\$)?|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9¹²³]|[Ll][Pp][Tt][0-9¹²³]) *(?:\\.|/|$))[^/\\\\:<>\"|?*\\u0000-\\u001f]*[^/\\\\:<>\"|?*\\u0000-\\u001f. ](?:/(?!(?:[Cc][Oo][Nn](?:[Ii][Nn]\\$|[Oo][Uu][Tt]\\$)?|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9¹²³]|[Ll][Pp][Tt][0-9¹²³]) *(?:\\.|/|$))[^/\\\\:<>\"|?*\\u0000-\\u001f]*[^/\\\\:<>\"|?*\\u0000-\\u001f. ])*$"
    },
    "licence": {
      "type": "object",
      "required": ["id", "name", "summary", "url", "commercial"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "description": "A few plain sentences: what the user may do, and the catches. Shown before the download.", "type": "string", "minLength": 20, "maxLength": 1200 },
        "url": { "description": "The full licence text.", "type": "string", "pattern": "^https://" },
        "commercial": { "enum": ["yes", "limited", "no"] }
      }
    },
    "file": {
      "type": "object",
      "required": ["repo", "file", "revision", "sha256", "size", "dest"],
      "additionalProperties": false,
      "properties": {
        "repo": { "description": "Hugging Face repo, owner/name.", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+$" },
        "file": { "$ref": "#/$defs/relativePath" },
        "revision": { "description": "The commit the file is pinned to. Never a branch name.", "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "dest": { "description": "Where it goes, relative to the user's models folder. Never a .part name: that is what YUKI calls a download that is not finished.", "$ref": "#/$defs/relativePath", "not": { "pattern": "\\.[Pp][Aa][Rr][Tt]$" } }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "title", "kind", "roles", "runtime", "minTier", "vramGb", "licence", "files"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["llm", "image", "video", "audio"] },
        "roles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "registryId": { "description": "The model registry entry these files complete.", "type": "string" },
        "runtime": { "enum": ["strata", "llama.cpp", "comfy"] },
        "minTier": { "$ref": "#/$defs/tier" },
        "vramGb": { "type": "number", "minimum": 0 },
        "vramMinGb": { "type": "number", "minimum": 0 },
        "ramGb": { "type": "number", "minimum": 0 },
        "gated": { "description": "Needs the user's own Hugging Face login.", "type": "boolean" },
        "licence": { "$ref": "#/$defs/licence" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "notes": { "type": "string" }
      }
    },
    "skill": {
      "type": "object",
      "required": ["id", "title", "version", "url", "sha256", "size", "licence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
        "url": { "description": "A SKILL.md or a .zip of the skill's folder.", "type": "string", "pattern": "^https://[^\\s]+\\.(md|zip)$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "licence": { "$ref": "#/$defs/licence" }
      }
    }
  }
}
